{
  // markdownlint-cli2 configuration.
  //
  // Rule configuration lives in `.markdownlint.jsonc`; this file carries the
  // cli2-only options. `ignores` is the single exclusion mechanism: unlike a
  // `.markdownlintignore` file (which markdownlint-cli2 does not read), it
  // applies both to glob runs and to the explicit file paths `lint-staged`
  // passes from the pre-commit hook.
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "ignores": [
    "node_modules/**",
    "dist/**",
    "build/**",
    "CHANGELOG.md",
    // Vendored third-party skill payloads and the overlays that mirror them are
    // written against their own upstream markdownlint config and are overwritten
    // on every re-vendor, so they are never linted here.
    "skills/**",
    ".agents/skills/**",
    ".claude/skills/**"
  ]
}
