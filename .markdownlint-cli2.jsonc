{
  // markdownlint-cli2 configuration.
  //
  // Rule configuration lives in `.markdownlint.jsonc`; this file carries the
  // cli2-only options. `ignores` is the single exclusion mechanism: unlike a
  // `.markdownlintignore` file, which markdownlint-cli2 does not read at all,
  // it applies to glob runs and to explicitly passed files alike.
  //
  // It matches relative paths only. `.lintstagedrc.js` converts the absolute
  // paths lint-staged supplies so the pre-commit hook inherits this list too.
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "ignores": [
    "**/node_modules/**",
    "dist/**",
    "build/**",
    "CHANGELOG.md",
    // Vendored third-party skill payloads and the overlays that mirror them are
    // written against their own upstream markdownlint config and are overwritten
    // on every re-vendor, so they are never linted here.
    ".agents/skills/**",
    ".claude/skills/**",
    "plugins/code/skills/code-review/**",
    "plugins/work/skills/ask-matt/**",
    "plugins/work/skills/codebase-design/**",
    "plugins/work/skills/design-control-loop/**",
    "plugins/work/skills/diagnosing-bugs/**",
    "plugins/work/skills/domain-modeling/**",
    "plugins/work/skills/grill-me/**",
    "plugins/work/skills/grilling/**",
    "plugins/work/skills/handoff/**",
    "plugins/work/skills/implement-spec/**",
    "plugins/work/skills/implement/**",
    "plugins/work/skills/improve-codebase-architecture/**",
    "plugins/work/skills/prototype/**",
    "plugins/work/skills/research/**",
    "plugins/work/skills/retro/**",
    "plugins/work/skills/setup-work-skills/**",
    "plugins/work/skills/show-me/**",
    "plugins/work/skills/tutor/**",
    "plugins/work/skills/to-questionnaire/**",
    "plugins/work/skills/to-spec/**",
    "plugins/work/skills/to-tickets/**",
    "plugins/work/skills/triage/**",
    "plugins/work/skills/wait-what/**",
    "plugins/work/skills/wayfinder/**",
    "plugins/work/skills/wizard/**",
    "plugins/work/skills/writing-for-agents/**"
  ]
}
